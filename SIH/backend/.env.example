# ========================================================
# SAFAR-SAATHI BACKEND ENVIRONMENT CONFIGURATION (.env)
# ========================================================

# PostgreSQL Database connection string (e.g. from Neon, Supabase, Render, or local PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:password@localhost:5432/safar_saathi

# JWT Authentication
SECRET_KEY=generate_a_secure_random_64_character_hex_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Client ID (matching frontend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend Public Base URL (Used for generating public upload links)
# Local: http://localhost:8000 | Production: https://your-backend.onrender.com
BASE_URL=http://localhost:8000

# Allowed CORS Origins (comma separated list of frontend domains)
# Example: https://safar-saathi.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini API Keys (comma-separated for auto-rotation and rate-limit cooldown)
GEMINI_API_KEY=your_gemini_api_key_here

# Fast2SMS Automated SMS Gateway API Key (Optional for SMS alerts)
FAST2SMS_API_KEY=
